{
  "expo": {
    "name": "Verso",
    "slug": "verso",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "verso",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verso.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Verso uses speech recognition for voice input to your AI coach.",
        "NSMicrophoneUsageDescription": "Verso uses the microphone for voice messages to your AI coach.",
        "NSFaceIDUsageDescription": "Verso uses Face ID for secure, quick access to your account."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.verso.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        { "color": "#FF5C28", "defaultChannel": "default" }
      ]
    ],
    "experiments": {
      "typedRoutes": "experimental"
    },
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "" }
    }
  }
}
